{
  "name": "seamless-markdown",
  "displayName": "Seamless Markdown",
  "description": "Edit Markdown in place with three modes: raw, half preview and full preview. Tables, images and formatting without a separate preview pane.",
  "version": "0.4.0",
  "publisher": "pepenotti",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e1b4b",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pepenotti/markdown-live-editor.git"
  },
  "bugs": {
    "url": "https://github.com/pepenotti/markdown-live-editor/issues"
  },
  "homepage": "https://github.com/pepenotti/markdown-live-editor#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "wysiwyg",
    "live preview",
    "table",
    "editor"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "npm run build && vscode-test",
    "test:vsix": "node scripts/test-vsix.mjs",
    "harness": "python3 -m http.server 5173",
    "package": "npm run build -- --production && vsce package --no-dependencies",
    "screenshots": "node scripts/screenshots.mjs",
    "demo-gif": "node scripts/demo-gif.mjs",
    "release:tag": "node scripts/tag-release.mjs",
    "notices": "node scripts/notices.mjs"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
