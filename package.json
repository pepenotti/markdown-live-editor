    "@lezer/rust": "^1.0.3",
    "@lezer/xml": "^1.0.6",
    "@lezer/yaml": "^1.0.4",
    "@types/markdown-it": "^14.2.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.4",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "gifenc": "^1.0.3",
    "jsdom": "^29.1.1",
