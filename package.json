        },
        {
          "command": "seamlessMarkdown.exportPdf",
          "when": "!seamlessMarkdown.pdfUnavailable && (resourceLangId == markdown || activeCustomEditorId == 'seamlessMarkdown.editor') && !isInDiffEditor",
          "group": "seamlessMarkdown.export@2"
        },
        {
          "command": "seamlessMarkdown.emailDocument",
          "when": "(resourceLangId == markdown || activeCustomEditorId == 'seamlessMarkdown.editor') && !isInDiffEditor",
          "group": "seamlessMarkdown.export@3"
        }
      ],
      "explorer/context": [
        {
          "command": "seamlessMarkdown.openWith",
          "when": "resourceLangId == markdown",
          "group": "navigation@90"
        },
        {
          "command": "seamlessMarkdown.exportHtml",
          "when": "resourceLangId == markdown",
          "group": "seamlessMarkdown.export@1"
        },
        {
          "command": "seamlessMarkdown.exportPdf",
          "when": "resourceLangId == markdown && !seamlessMarkdown.pdfUnavailable",
          "group": "seamlessMarkdown.export@2"
        },
        {
          "command": "seamlessMarkdown.emailDocument",
          "when": "resourceLangId == markdown",
          "group": "seamlessMarkdown.export@3"
        }
      ]
    },
    "configuration": {
      "title": "Seamless Markdown",
      "properties": {
        "seamlessMarkdown.defaultMode": {
          "type": "string",
          "enum": [
            "raw",
            "half",
            "full"
          ],
          "enumDescriptions": [
            "Plain Markdown source.",
            "Rendered, with the syntax shown for the element the cursor is on.",
            "Looks like the finished document; syntax stays hidden and is edited through popovers and the toolbar."
          ],
          "default": "half",
          "description": "Mode a Markdown file opens in when no mode has been remembered for it."
        },
        "seamlessMarkdown.rememberModePerFile": {
          "type": "boolean",
          "default": true,
          "description": "Reopen each file in the mode it was last used in."
        },
        "seamlessMarkdown.lineWidth": {
          "type": "number",
          "default": 860,
          "minimum": 0,
          "description": "Maximum width of the text column in the preview modes, in pixels. 0 uses the full width."
        },
        "seamlessMarkdown.fontSize": {
          "type": "number",
          "default": 15,
          "minimum": 8,
          "maximum": 40,
          "description": "Font size of the preview modes, in pixels. Raw mode uses the editor font size."
        },
        "seamlessMarkdown.fontFamily": {
          "type": "string",
          "default": "",
          "description": "Font family of the preview modes. Empty uses the VS Code interface font."
        },
        "seamlessMarkdown.showToolbar": {
          "type": "boolean",
          "default": true,
          "description": "Show the formatting toolbar above the document."
        },
        "seamlessMarkdown.imageFolder": {
          "type": "string",
          "default": "assets",
          "markdownDescription": "Folder for pasted and dropped images, relative to the document. `${fileBasenameNoExtension}` is replaced by the document name without its extension."
        },
        "seamlessMarkdown.tableAutoAlign": {
          "type": "boolean",
          "default": true,
          "description": "Re-align the pipes of a table in the source whenever one of its cells is edited. When off, only the edited cell changes."
        },
        "seamlessMarkdown.pasteRichText": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Paste formatted text copied from a web page or a word processor as Markdown. Paste with `Shift` held to get the plain text."
        },
        "seamlessMarkdown.toc.updateOnSave": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Bring the table of contents between `<!-- toc -->` and `<!-- tocstop -->` up to date when a Markdown file is saved, also in the plain text editor. Files without these markers are never changed."
        },
        "seamlessMarkdown.toc.levels": {
          "type": "string",
          "default": "1..6",
          "pattern": "^\\s*[1-6]\\s*(\\.\\.\\s*[1-6]\\s*)?$",
          "patternErrorMessage": "Use a range such as 2..4, or a single level such as 2.",
          "markdownDescription": "Heading levels listed in a table of contents, for example `2..4`. A single H1 is taken to be the title and is always left out."
        },
        "seamlessMarkdown.toc.ordered": {
          "type": "boolean",
          "default": false,
          "description": "Write the table of contents as a numbered list instead of bullets."
        },
        "seamlessMarkdown.promptToSetDefault": {
          "type": "boolean",
          "default": true,
          "description": "Ask once whether Markdown files should open with this editor by default."
        },
        "seamlessMarkdown.checkLinks": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Underline links and images whose file does not exist, links to a heading that does not exist, and reference links without a definition. They are also listed in the Problems panel. Web links are not checked."
        },
        "seamlessMarkdown.customCss": {
          "type": "string",
          "default": "",
          "editPresentation": "multilineText",
          "markdownDescription": "Extra CSS rules for the editor, for example `#app .cm-content { font-family: Georgia; }`."
        },
        "seamlessMarkdown.export.embedImages": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Embed local images in the file written by **Export as HTML**, so that it can be moved or sent on its own. When off, images keep their relative paths. A PDF always contains its images."
        },
        "seamlessMarkdown.export.browserPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Path of the Chrome, Edge, Chromium or Brave executable that **Export as PDF** prints with and that draws Mermaid diagrams for both exports. Empty looks in the usual places. Without such a browser PDF export is not offered, and diagrams are exported as their source."
        },
        "seamlessMarkdown.email.to": {
          "type": "string",
          "default": "",
          "markdownDescription": "Address that **Email Document** puts in the To field of the new message. Several can be separated by commas. Empty leaves the field for you to fill in."
        },
        "seamlessMarkdown.spellCheck": {
          "type": "boolean",
          "default": false,
          "description": "Ask the editor's built-in spell checker to check the text and table cells. Whether misspelled words are underlined depends on VS Code and the operating system."
        },
        "seamlessMarkdown.wikiLinks": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Treat `[[Note]]` as a link to another Markdown file of the workspace, check that the note exists, and show a Backlinks view in the Explorer. Wiki links are not standard Markdown, so other tools show them as plain text."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "seamlessMarkdown.outline",
          "name": "Markdown Outline",
          "when": "activeCustomEditorId == 'seamlessMarkdown.editor'",
          "icon": "$(list-tree)",
          "contextualTitle": "Seamless Markdown"
        },
        {
          "id": "seamlessMarkdown.backlinks",
          "name": "Backlinks",
          "when": "activeCustomEditorId == 'seamlessMarkdown.editor' && config.seamlessMarkdown.wikiLinks",
          "icon": "$(references)",
          "contextualTitle": "Seamless Markdown"
        }
      ]
    }
  }
}
